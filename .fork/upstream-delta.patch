+    }
+}
diff --git a/extensions/reddit/src/test/java/app/morphe/extension/reddit/nsfw/NsfwPostDetectorSelfTest.java b/extensions/reddit/src/test/java/app/morphe/extension/reddit/nsfw/NsfwPostDetectorSelfTest.java
